# Standalone install. Their server runs the portal and the engine.
# Their Supabase project holds the users and the reports.
# The Lazarus database is not in this file. A company API key is not this install.
#
# Company key, hosted app: their server sends the call to the Lazarus API,
# that API sends the transcript to Google Gemini, then saves the report
# in the Lazarus database. The saved row has no transcript.
#
# This file: the call is handled on their server. Scoring sends the transcript
# from their server to generativelanguage.googleapis.com with their Gemini key.
# The report row is written to their database. server/reportSanitize.ts still
# drops the transcript before that write. It does not read LAZARUS_API_KEY.
#
# Do not copy keys from .env.example. That file is getldr.ca, Render, Stripe,
# and LAZARUS_API_KEY. Apply supabase/migrations to their project, then
# npm install && npm start. The hosted site, the terms, and the provider order stay as they are.

# 1. Their database
# Create the project, then run the SQL in supabase/migrations against it.
# The URL is the project URL, not https://supabase.co.
SUPABASE_URL=https://their-project.supabase.co
SUPABASE_ANON_KEY=their_anon_key
SUPABASE_SERVICE_ROLE_KEY=their_service_role_key

# 2. Browser build
# Set these before npm run build. They are baked into the portal.
# Leave VITE_API_URL empty so the browser talks to this server, not getldr.ca.
VITE_SUPABASE_URL=https://their-project.supabase.co
VITE_SUPABASE_ANON_KEY=their_anon_key
VITE_API_URL=

# 3. Their model and transcription accounts
# GEMINI_API_KEY is a Google key they own. Scoring calls generativelanguage.googleapis.com
# (default model gemini-2.5-flash). The transcript leaves their network for that call.
# They read Google's API data terms for this key.
# Do not set OPENROUTER_API_KEY, CEREBRAS_API_KEY, or GROQ_API_KEY on this server.
GEMINI_API_KEY=their_google_gemini_key

# ASSEMBLYAI_API_KEY sends the recording to AssemblyAI. Omit it if this install will not transcribe audio.
ASSEMBLYAI_API_KEY=their_assemblyai_key

# 4. This server's address
# PUBLIC_API_URL is the origin only. The app adds /api/integrations/.../callback itself.
# https://portal.their-company.example/api would produce a doubled /api/api path.
PORT=3001
FRONTEND_ORIGIN=https://portal.their-company.example
PUBLIC_API_URL=https://portal.their-company.example

# 5. OAuth apps they register
# Redirect URLs on this host, for example:
#   https://portal.their-company.example/api/integrations/google/callback
#   https://portal.their-company.example/api/integrations/hubspot/callback
#   https://portal.their-company.example/api/integrations/salesforce/callback
# Leave a provider blank and that login stays off.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=

# 6. Secrets generated on this server
# Any long random string. The app hashes TOKEN_ENCRYPTION_KEY. It does not need a 32-character hex value.
# Leave them here. Do not send them to Lazarus.
OAUTH_STATE_SECRET=generate-a-long-random-string-on-this-server
TOKEN_ENCRYPTION_KEY=generate-another-long-random-string-on-this-server

# Leave these off this install
# STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, and the Stripe price ids belong to the hosted demo.
# LAZARUS_API_KEY is the shared cloud key. It does not belong on a company server.
# OPENROUTER_API_KEY, CEREBRAS_API_KEY, and GROQ_API_KEY stay off so those fallbacks do not run.
# Do not copy the Lazarus service-role key, Gemini key, or any other Lazarus secret into this file.
