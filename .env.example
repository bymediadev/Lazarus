# ─── Railway API (recommended if Gemini key lives on Railway) ───
# Point the UI at your deployed backend (no trailing slash):
# VITE_API_URL=https://your-service.up.railway.app
#
# On Railway, set these service variables:
#   GEMINI_API_KEY=AIzaSy...          (from https://aistudio.google.com/apikey)
#   FRONTEND_ORIGIN=http://localhost:5173,https://lazarusdealrescue.lovable.app
#   ASSEMBLYAI_API_KEY=...            (optional, for audio upload)
#   SUPABASE_URL=...                  (optional, for persistence)
#   SUPABASE_SERVICE_ROLE_KEY=...
#
# Local UI + Railway API: set VITE_API_URL below, then run: npm run dev:ui

# ─── Local full stack (API + UI on this machine) ───
# Leave VITE_API_URL empty and run: npm run dev
# GEMINI_API_KEY must be a valid AI Studio key (starts with AIzaSy)

GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.5-flash

ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here
# ASSEMBLYAI_SPEAKERS=2

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Data retention (days) — transcript_text nulled after this window; analysis_json kept
# DATA_RETENTION_DAYS=30
# PURGE_CRON_SECRET=random-secret-for-scheduled-purge-cron
# LAZARUS_API_KEY=optional-key-for-production-api-auth

PORT=3001

# VITE_API_URL=https://your-service.up.railway.app

# FRONTEND_ORIGIN=http://localhost:5173,https://your-app.lovable.app

# Windows TLS (if npm install or Gemini fetch fails):
# powershell -File scripts/export-windows-cas.ps1
