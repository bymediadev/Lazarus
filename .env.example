# ─── Render (production monolith — API + UI on one service) ───
# Dashboard: New Web Service → build `npm install && npm run build`, start `npm start`, health `/api/health`
# Or: New Blueprint → repo includes render.yaml
#
# Copy from local .env into Render → Variables (no trailing slashes on URLs):
#   GEMINI_API_KEY, SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, PURGE_CRON_SECRET, DATA_RETENTION_DAYS
#   FRONTEND_ORIGIN=https://your-app.onrender.com,http://localhost:5173
#   LAZARUS_API_KEY=<same random string as VITE_LAZARUS_API_KEY below>
#   VITE_LAZARUS_API_KEY=<same value — baked into UI at build time on Render>
# Skip VITE_API_URL on Render monolith (same-origin /api).
#
# GitHub Actions purge cron: LAZARUS_API_URL=https://your-app.onrender.com (same PURGE_CRON_SECRET)
#
# ─── Split deploy (optional: Lovable UI + Render API only) ───
# VITE_API_URL=https://your-app.onrender.com  (set on Lovable build, not Render monolith)

# ─── Local full stack (API + UI on this machine) ───
# Leave VITE_API_URL empty and run: npm run dev
# GEMINI_API_KEY must be a valid AI Studio key (starts with AIzaSy)

GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.5-flash

ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here
# ASSEMBLYAI_SPEAKERS=2

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Data retention (days) — transcript_text nulled after this window; analysis_json kept
# DATA_RETENTION_DAYS=30
# PURGE_CRON_SECRET=random-secret-for-scheduled-purge-cron

# Production API auth — use the same value for both (generate a long random string)
# LAZARUS_API_KEY=your_production_api_key_here
# VITE_LAZARUS_API_KEY=your_production_api_key_here

PORT=3001

# VITE_API_URL=https://your-app.onrender.com

# FRONTEND_ORIGIN=http://localhost:5173,https://your-app.onrender.com

# Windows TLS (if npm install or Gemini fetch fails):
# powershell -File scripts/export-windows-cas.ps1
