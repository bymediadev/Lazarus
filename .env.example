# Gemini (required for post-mortem analysis)
GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.5-flash

# AssemblyAI (optional — only needed for audio upload transcription)
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here
# ASSEMBLYAI_SPEAKERS=2

# Supabase (optional — post-mortems still work without persistence)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Server
PORT=3001

# Frontend → backend wiring
# Local dev: leave VITE_API_URL empty (Vite proxies /api → localhost:3001)
# Lovable / separate frontend host: set to your deployed API, e.g. https://your-api.railway.app
# VITE_API_URL=https://your-api.example.com

# Comma-separated origins allowed to call the API (add your Lovable URL here)
# FRONTEND_ORIGIN=http://localhost:5173,https://your-app.lovable.app
# If npm install fails with UNABLE_TO_VERIFY_LEAF_SIGNATURE on this machine:
# 1. Run: powershell -File scripts/export-windows-cas.ps1
# 2. Set:  npm config set cafile "path\to\windows-extra-cas.pem"
# 3. Or per-session: NODE_EXTRA_CA_CERTS=path\to\windows-extra-cas.pem
